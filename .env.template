# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
# Este archivo SÍ va al repositorio: es la guía de qué variables hacen falta.
# El .env real NO va (está en .gitignore), porque lleva credenciales.
#
# Para empezar:
#     cp .env.template .env
# y completá los valores de abajo. Después: docker compose up -d
#
# No hace falta el --build: el compose.yml tiene pull_policy: build, así que
# reconstruye la imagen en cada "up" sin que tengas que borrar nada.
# =============================================================================

# Nombre de la base de datos que crea Postgres al arrancar por primera vez.
DB_NAME=cowsvsclown_db

# Usuario y contraseña de Postgres. Se crean automáticamente en el contenedor.
# Poné lo que quieras en desarrollo; en producción usá valores fuertes.
DB_USER=postgres
DB_PASSWORD=changeme

# Puerto de TU MÁQUINA (el host) por el que vas a poder entrar a la base,
# por ejemplo desde DBeaver o psql.
# Dentro de la red de Docker los contenedores siempre se hablan por el 5432,
# así que esto NO afecta a la app: solo cambia por dónde entrás vos.
# Si ya tenés un Postgres local ocupando el 5432, poné 5433 acá.
DB_PORT=5432


# =============================================================================
# KEYCLOAK
# =============================================================================
# Keycloak es el que guarda usuarios, contraseñas y roles. La API no guarda
# ninguna de esas cosas: solo valida el token que Keycloak emite.

# Puerto de TU MÁQUINA para entrar a Keycloak.
# Tiene que ser distinto de 8080, que ya lo usa la API.
#
# IMPORTANTE: si cambiás este puerto, el claim "iss" de los tokens cambia con
# él (compose.yml arma la URL pública a partir de esta variable). Es coherente
# porque la app valida contra esa misma URL, pero acordate de reiniciar todo
# con "docker compose down && docker compose up -d": los tokens que hayas
# pedido antes dejan de servir.
KEYCLOAK_PORT=8081

# Usuario administrador de la CONSOLA de Keycloak (http://localhost:8081).
# No es un usuario de la API: es el que administra el propio Keycloak.
# En desarrollo admin/admin está bien; en producción, nunca.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Nombre del realm y del cliente. Tienen que coincidir EXACTAMENTE con los que
# están dentro de keycloak/realm-cowsvsclown.json ("realm" y "clientId"):
# de acá salen las URLs con las que la app valida los tokens, así que una letra
# distinta se traduce en un 401 en todas las operaciones protegidas.
KEYCLOAK_REALM=cowsvsclown
KEYCLOAK_CLIENT_ID=cowsvsclown-api
