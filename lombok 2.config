# Marca todo lo que Lombok genera (getters, setters, equals, builders...) con
# @lombok.Generated. JaCoCo respeta esa anotación y NO la cuenta como código sin
# cubrir, así que el porcentaje refleja código escrito por nosotros y no
# boilerplate que nunca vamos a testear a mano.
lombok.addLombokGeneratedAnnotation = true

# Evita que Lombok siga buscando archivos de config en carpetas superiores.
config.stopBubbling = true
